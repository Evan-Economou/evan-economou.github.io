# Cloudflare response headers. Hugo copies this file into public/ and
# Cloudflare reads it at deploy time. The file itself is never served.
# Same headers as deploy/Caddyfile. Change both if you change one.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  X-Robots-Tag: noai, noimageai

# CSS and JS filenames contain a hash of their contents, so they can be
# cached forever. Each edit produces a new filename.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
